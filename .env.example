# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=3001

# Exact frontend origin — a wildcard is illegal alongside credentialed CORS.
CLIENT_ORIGIN=http://localhost:3000
# Omit for localhost; set to the shared parent domain in production (.example.com)
COOKIE_DOMAIN=localhost

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/edstellar_lms
# Set to true only if the Postgres server requires/terminates TLS.
DATABASE_SSL=false
# When DATABASE_SSL=true, verify the server's certificate by default. Only set
# this to false for a self-signed cert you've deliberately chosen to trust —
# it disables protection against a man-in-the-middle on the connection.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Auth — must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-long-random-secret>
AUTH_TOKEN_DAYS=7
AUTH_COOKIE_NAME=lms_token

# SCORM storage. `local` writes to SCORM_STORAGE_PATH; `s3` is not implemented yet.
SCORM_STORAGE_DRIVER=local
SCORM_STORAGE_PATH=./storage/scorm
