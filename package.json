{
  "name": "edstellar-lms-server",
  "version": "0.1.0",
  "private": true,
  "description": "Edstellar LMS backend. NestJS + Drizzle + PostgreSQL. Owns the entire database schema and every API endpoint.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed.mjs",
    "db:detach-assessments": "node scripts/detach-all-assessments.mjs",
    "db:reset-to-admin": "node scripts/reset-to-admin-only.mjs",
    "db:migrate:tenancy": "node scripts/migrate-tenancy.mjs",
    "db:migrate:rbac": "node scripts/migrate-rbac.mjs",
    "db:verify:rbac": "node scripts/verify-rbac.mjs",
    "db:create-org-role": "node scripts/create-org-role.mjs",
    "db:create-org-user": "node scripts/create-org-user.mjs",
    "db:create-platform-admin": "node scripts/create-platform-admin.mjs",
    "test:isolation": "node scripts/test-isolation.mjs",
    "db:clean-orphan-scorm": "node scripts/clean-orphan-scorm.mjs",
    "db:seed-history": "node scripts/seed-history.mjs",
    "email:verify": "node scripts/verify-email.mjs",
    "db:migrate:scorm-r2": "node scripts/migrate-scorm-to-r2.mjs",
    "email:gmail-authorize": "node scripts/gmail-authorize.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand && node test/route-coverage.mjs",
    "retention:sweep": "node dist/retention-cli.js",
    "test:e2e:ci": "jest --config ./test/jest-e2e.json --runInBand && node test/route-coverage.mjs --strict",
    "e2e:db": "node test/e2e-db.js",
    "e2e:schema": "node test/snapshot-schema.js",
    "e2e:web-api": "node -r ts-node/register/transpile-only -r tsconfig-paths/register test/web-api.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sesv2": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.5.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "country-state-city": "^3.2.1",
    "drizzle-orm": "^0.38.0",
    "fast-xml-parser": "^5.9.2",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "pg": "^8.13.0",
    "pg-boss": "^12.35.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.10",
    "@types/adm-zip": "^0.5.7",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.30.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
